# Este valor va en ".env.development" (para "npm run dev"), NO en ".env"
# a secas -- Vite carga ".env.development" solo en modo desarrollo, así
# que no termina horneado por accidente en el build de producción
# ("npm run build"), que debe usar la URL relativa por defecto ("/api",
# ver src/api/client.ts) para funcionar en cualquier dominio.
VITE_API_URL=http://localhost:8001/api
