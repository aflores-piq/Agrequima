# Copiar este archivo a ".env" (sin ".ejemplo") en esta misma carpeta,
# y completar los valores reales antes de correr sync_piq_ia.py.
# Ver LEEME.txt, paso 3, para instrucciones detalladas de cada variable.

# --- ORIGEN: de donde vienen los datos ---
# Mientras se prueba (o si todavia no hay VPN al cliente), usar la base
# de Desarrollo-2 (SYNC_ORIGEN_DB_SERVER=Desarrollo-2, DB_NAME=AGREQUIMA)
# -- es la UNICA seccion que despues hay que cambiar para apuntar al
# cliente real. IMPORTANTE: "10.10.0.6,65280" es la direccion real que
# nos dieron para el cliente, pero TODAVIA NO SE PUDO VERIFICAR que esa
# base tenga tablas llamadas exactamente "Importacion"/"Nutrientes" con
# las mismas columnas (no hubo conectividad para revisarlo). Si al
# conectar a esa IP las tablas se llaman distinto o tienen otras
# columnas, avisar antes de usar esto en produccion -- puede hacer
# falta ajustar el script, no solo esta configuracion.
SYNC_ORIGEN_DB_SERVER=10.10.0.6,65280
SYNC_ORIGEN_DB_NAME=<NOMBRE_REAL_DE_LA_BASE_DEL_CLIENTE_SIN_CONFIRMAR>
SYNC_ORIGEN_DB_USER=
SYNC_ORIGEN_DB_PASSWORD=

# --- DESTINO: la base PIQ_IA en ESTE servidor ---
# Si SQL Server esta instalado en esta misma maquina (lo normal), el
# server es "localhost" o el nombre de esta PC. Si PIQ_IA vive en otra
# maquina de esta misma red, poner su nombre/IP aca.
SYNC_DESTINO_DB_SERVER=localhost
SYNC_DESTINO_DB_NAME=PIQ_IA
SYNC_DESTINO_DB_USER=sa
SYNC_DESTINO_DB_PASSWORD=

# --- Driver ODBC instalado en este servidor (ver LEEME.txt paso 0) ---
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- Tablas a espejar cada noche (separadas por coma, sin espacios) ---
# Agregar mas tablas aca en el futuro (Indicadores) no requiere tocar
# ningun codigo.
SYNC_TABLAS=Importacion,Nutrientes,CatalogoNomenclaturaPlaguicidas,CatalogoAgrupadorNutrientes

# --- FINANCIERO: segundo origen, independiente del de arriba ---
# Vistas de solo lectura de CONTACC (contabilidad del cliente), en un
# servidor/base DISTINTOS de SYNC_ORIGEN_* -- por eso tienen su propio
# bloque de conexion. IMPORTANTE: todavia no se confirmo conectividad
# ni credenciales reales contra "10.10.0.6,65280" para la base CONTACC
# especificamente (si hay un usuario que ya sirve para leerla, avisar
# antes de completar esto en produccion).
SYNC_CONTACC_DB_SERVER=10.10.0.6,65280
SYNC_CONTACC_DB_NAME=CONTACC
SYNC_CONTACC_DB_USER=
SYNC_CONTACC_DB_PASSWORD=

# Vistas a espejar desde CONTACC hacia PIQ_IA (mismo nombre en destino).
# NO agregar vw_piq_viaticos ni vw_piq_kilometraje -- fuera de alcance.
SYNC_VISTAS_CONTACC=vw_piq_balance_saldos,vw_piq_balance_general,vw_catalogo_cuentas,vw_piq_centrosdecosto,vw_piq_presupuestos,vw_piq_cheques_circulacion,vw_piq_asociados_cuota,vw_piq_saldos_bancos
